; Engine configuration file.
; It's best edited using the editor if possible.

config_version=5

[application]
config/name="Karinderya ni Andreng"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.3")

[autoload]
GameManager="*res://scripts/autoload/game_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AchievementManager="*res://scripts/autoload/achievement_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="2d"
textures/canvas_textures/default_texture_filter=0
